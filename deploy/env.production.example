# Production .env for the ProxMox LXC behind Cloudflare Tunnel (agenda.sudomie.pl). Copy to /opt/hotelagenda/.env.
# Generate secrets: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_DB=hotelagenda
POSTGRES_USER=hotelagenda
POSTGRES_PASSWORD=replace-with-a-long-random-password
DEBUG=0

# TLS ends at Cloudflare; the tunnel talks plain HTTP to Caddy inside the Docker network.
SITE_ADDRESS=:80
HTTP_PORT=127.0.0.1:8090
HTTPS_PORT=127.0.0.1:8453
# Tunnel: deploy/cloudflared/config.yml + <UUID>.json (created from the terminal, deploy/PROXMOX-HP.md).

# Domain (replace agenda.example.pl everywhere below)
ALLOWED_HOSTS=agenda.example.pl
CSRF_TRUSTED_ORIGINS=https://agenda.example.pl
SECURE_COOKIES=1
# CLAUDE.md: behind a proxy SSL_REDIRECT=1 only together with SECURE_PROXY_SSL_HEADER (always on in settings).
SSL_REDIRECT=1
# Caddy trusts X-Forwarded-* only from the tunnel container (Docker private network).
TRUSTED_PROXY_CIDRS=private_ranges
PUBLIC_HOSTS=agenda.example.pl

# Tuning (defaults are fine)
SCREEN_SLIDE_SECONDS=12
SCREEN_REFRESH_SECONDS=60
GUEST_LINK_GRACE_DAYS=3
# RODO: login trail kept this many days (retencja_danych runs after the nightly backup)
RETENCJA_LOGIN_DNI=365
# Self-registration: POSTs per IP
THROTTLE_REGISTRATION=5/hour
# GA4 on public pages (landing, rejestracja, regulamin) with Consent Mode v2; empty = no tag
GA_MEASUREMENT_ID=

# „Wypróbuj demo” on the landing page: sandboxes at once (0 = button hidden), hours each lives, new demos per IP
DEMO_MAX=200
DEMO_HOURS=24
THROTTLE_DEMO=10/hour

# Newsletter sudomie przy rejestracji. Pusty klucz = pole ukryte, nic nie wysyłamy.
# Klucz tej aplikacji: ~/.config/sudomie/newsletter-env-dla-aplikacji.txt (laptop Konrada).
NEWSLETTER_URL=https://sudomie.pl/chat-api/newsletter
NEWSLETTER_KLUCZ=
